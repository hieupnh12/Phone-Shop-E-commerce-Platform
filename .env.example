# Sao chép: cp .env.example .env

# Tên miền
APP_DOMAIN=maclenin.io.vn
APP_PUBLIC_URL=https://maclenin.io.vn
CERTBOT_EMAIL=your@gmail.com

# MySQL (Aiven)
SPRING_DATASOURCE_URL=jdbc:mysql://your-host:port/phoneShop
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=your_db_password

# Frontend — API qua nginx cùng origin
REACT_APP_API_URL=/phoneShop

# CORS
APP_CORS_ALLOWED_ORIGINS=http://maclenin.io.vn,https://maclenin.io.vn,http://www.maclenin.io.vn,https://www.maclenin.io.vn,http://localhost:3000

# Google OAuth redirect
GOOGLE_OAUTH2_REDIRECT_URI=https://maclenin.io.vn/phoneShop/login/oauth2/code/google

# Reset mật khẩu admin khi backend khởi động (tài khoản mặc định: sinhnnde180169@fpt.edu.vn / 999999999)
APP_ADMIN_EMAIL=sinhnnde180169@fpt.edu.vn
APP_ADMIN_PASSWORD=999999999

# Email Gmail
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# JWT
JWT_SIGNER_KEY=your_jwt_signer_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SpeedSMS
SPEEDSMS_ACCESS_TOKEN=your_speedsms_token

# Gemini (Spring AI)
SPRING_AI_OPENAI_API_KEY=your_gemini_api_key

# PayOS
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_LOG_LEVEL=INFO

# GCP deploy (SSH dùng IP, web dùng domain)
GCP_INSTANCE=instance-mobile
GCP_ZONE=asia-east1-c
GCP_EXTERNAL_IP=35.221.155.202
VPS_HOST=35.221.155.202
VPS_USER=hieupnh12
REMOTE_DIR=~/group_1

# Docker Hub
DOCKERHUB_USER=hieupnh12
IMAGE_TAG=latest
